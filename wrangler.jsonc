// Cloudflare sustituye el identificador provisional al crear tu base de datos.
{
  "name": "hogar-familiar",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hogar-familiar-db",
      "database_id": "07af661f-d8fc-4a1c-95bb-d53d1770acc9",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
